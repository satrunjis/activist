# Database
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/activist_base?sslmode=disable

# Backend
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
SESSION_COOKIE_NAME=__Host-session
SESSION_IDLE_TTL=30m
SESSION_ABSOLUTE_TTL=8h
LOG_LEVEL=info
SEED_SUPERUSER_LOGIN=superadmin
SEED_SUPERUSER_PASSWORD=change-me

# Dev tools
DEV_AUTH_ASSUME_ADMIN=false
DEV_AUTH_ADMIN_LOGIN=admin
E2E_FRONTEND_URL=http://localhost:5173
E2E_API_BASE_URL=http://localhost:8080/api/v1
E2E_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/activist_base?sslmode=disable
DEMO_API_BASE_URL=http://localhost:8080/api/v1
DEMO_PG_CONTAINER=activist-base-pg
DEMO_PG_USER=postgres
DEMO_PG_DATABASE=activist_base
PERF_BASE_URL=http://127.0.0.1:8080
PERF_BACKEND_PORT=8080
PERF_BACKEND_CONTAINER=
PERF_LOGIN=admin
PERF_PASSWORD=change-me

# Production deploy (deploy/.env on server - never commit)
DB_USER=activist
DB_PASSWORD=change-me
DB_NAME=activist
SEED_SUPERUSER_LOGIN=superadmin
SEED_SUPERUSER_PASSWORD=change-me
